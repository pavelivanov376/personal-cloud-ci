<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Dialog id="addJobDialog" title="Add Job" contentWidth="400px">
        <content>
            <VBox class="sapUiSmallMargin sapUiSmallMarginTop">
                <Label text="Name" required="true"/>
                <Input id="nameInput" placeholder="my-job" width="100%" class="sapUiSmallMarginBottom"/>
                <Label text="Repository" required="true"/>
                <Select id="repositorySelect" width="100%">
                    <items>
                        <core:Item key="" text="-- Select a repository --"/>
                    </items>
                </Select>
            </VBox>
        </content>
        <beginButton>
            <Button text="Add" type="Emphasized" press=".onConfirmAdd"/>
        </beginButton>
        <endButton>
            <Button text="Cancel" press=".onCancelAdd"/>
        </endButton>
    </Dialog>

</core:FragmentDefinition>
