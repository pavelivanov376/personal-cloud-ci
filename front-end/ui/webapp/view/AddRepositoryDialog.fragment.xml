<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Dialog id="addDialog" title="Add Repository" contentWidth="400px">
        <content>
            <VBox class="sapUiSmallMargin sapUiSmallMarginTop">
                <Label text="Name" required="true"/>
                <Input id="nameInput" placeholder="my-repo" width="100%" class="sapUiSmallMarginBottom"/>
                <Label text="URL" required="true"/>
                <Input id="urlInput" placeholder="https://github.com/org/repo" width="100%"/>
            </VBox>
        </content>
        <beginButton>
            <Button text="Add" type="Emphasized" press=".onConfirmAdd"/>
        </beginButton>
        <endButton>
            <Button text="Cancel" press=".onCancelAdd"/>
        </endButton>
    </Dialog>

</core:FragmentDefinition>
