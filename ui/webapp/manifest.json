{
  "sap.app": {
    "id": "app",
    "type": "application",
    "applicationVersion": { "version": "1.0.0" }
  },
  "sap.ui5": {
    "rootView": {
      "viewName": "app.view.App",
      "type": "XML",
      "async": true,
      "id": "app"
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "type": "View",
        "viewType": "XML",
        "path": "app.view",
        "controlId": "navContainer",
        "controlAggregation": "pages",
        "async": true
      },
      "routes": [
        { "name": "repositories", "pattern": "", "target": "repositories" },
        { "name": "jobs", "pattern": "jobs", "target": "jobs" }
      ],
      "targets": {
        "repositories": { "id": "repositories", "name": "Repositories" },
        "jobs": { "id": "jobs", "name": "Jobs" }
      }
    }
  }
}
